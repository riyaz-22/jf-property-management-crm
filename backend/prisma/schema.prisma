generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  PROPERTY_MANAGER
  AGENT
  ACCOUNTANT
  MAINTENANCE
  VIEWER
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  OCCUPIED
  UNDER_MAINTENANCE
  SOLD
  ARCHIVED
}

enum PropertyType {
  FLAT
  HOUSE
  TOWNHOUSE
  COMMERCIAL
  LAND
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRING
  RENEWED
  TERMINATED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  DIRECT_DEBIT
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_TENANT
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  TASK
}

enum ActivityType {
  SYSTEM
  PROPERTY
  TENANT
  LEASE
  PAYMENT
  MAINTENANCE
  AUTH
}

model User {
  id              String               @id @default(uuid())
  email           String               @unique @db.VarChar(255)
  passwordHash    String
  firstName       String               @db.VarChar(100)
  lastName        String               @db.VarChar(100)
  phone           String?              @db.VarChar(40)
  avatarUrl       String?
  role            Role                 @default(PROPERTY_MANAGER)
  isActive        Boolean              @default(true)
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  refreshTokens   RefreshToken[]
  resetTokens     PasswordResetToken[]
  properties      Property[]           @relation("PropertyManager")
  assignedTickets MaintenanceTicket[]  @relation("TicketAssignee")
  notifications   Notification[]
  activities      Activity[]

  @@index([role])
  @@index([deletedAt])
}

model RefreshToken {
  id                String    @id @default(uuid())
  tokenHash         String    @unique
  userId            String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdByIp       String?
  revokedByIp       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Property {
  id                 String              @id @default(uuid())
  reference          String              @unique @db.VarChar(40)
  title              String              @db.VarChar(160)
  type               PropertyType
  status             PropertyStatus      @default(DRAFT)
  addressLine1       String
  addressLine2       String?
  city               String              @db.VarChar(120)
  postcode           String              @db.VarChar(20)
  country            String              @default("United Kingdom")
  bedrooms           Int                 @default(0)
  bathrooms          Int                 @default(0)
  rentAmount         Decimal             @db.Decimal(12, 2)
  depositAmount      Decimal             @db.Decimal(12, 2)
  askingPrice        Decimal?            @db.Decimal(14, 2)
  ownerName          String?             @db.VarChar(160)
  ownerEmail         String?             @db.VarChar(255)
  managerId          String?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  manager            User?               @relation("PropertyManager", fields: [managerId], references: [id], onDelete: SetNull)
  tenants            Tenant[]
  leases             Lease[]
  payments           Payment[]
  maintenanceTickets MaintenanceTicket[]
  activities         Activity[]

  @@index([status])
  @@index([city])
  @@index([postcode])
  @@index([managerId])
  @@index([deletedAt])
}

model Tenant {
  id                 String              @id @default(uuid())
  firstName          String              @db.VarChar(100)
  lastName           String              @db.VarChar(100)
  email              String              @unique @db.VarChar(255)
  phone              String?             @db.VarChar(40)
  dateOfBirth        DateTime?
  status             String              @default("ACTIVE") @db.VarChar(40)
  currentPropertyId  String?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  currentProperty    Property?           @relation(fields: [currentPropertyId], references: [id], onDelete: SetNull)
  leases             Lease[]
  payments           Payment[]
  maintenanceTickets MaintenanceTicket[]

  @@index([currentPropertyId])
  @@index([status])
  @@index([deletedAt])
}

model Lease {
  id               String      @id @default(uuid())
  propertyId       String
  tenantId         String
  startDate        DateTime
  endDate          DateTime
  rentAmount       Decimal     @db.Decimal(12, 2)
  depositAmount    Decimal     @db.Decimal(12, 2)
  status           LeaseStatus @default(DRAFT)
  renewalOfferedAt DateTime?
  signedAt         DateTime?
  terminatedAt     DateTime?
  notes            String?
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  property         Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payments         Payment[]

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@index([endDate])
  @@index([deletedAt])
}

model Payment {
  id         String         @id @default(uuid())
  reference  String         @unique @db.VarChar(60)
  propertyId String
  tenantId   String
  leaseId    String?
  amount     Decimal        @db.Decimal(12, 2)
  dueDate    DateTime
  paidAt     DateTime?
  status     PaymentStatus  @default(PENDING)
  method     PaymentMethod?
  notes      String?
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lease      Lease?         @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([tenantId])
  @@index([leaseId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
}

model MaintenanceTicket {
  id            String              @id @default(uuid())
  propertyId    String
  tenantId      String?
  assigneeId    String?
  title         String              @db.VarChar(180)
  description   String
  priority      MaintenancePriority @default(MEDIUM)
  status        MaintenanceStatus   @default(OPEN)
  dueDate       DateTime?
  completedAt   DateTime?
  cost          Decimal?            @db.Decimal(12, 2)
  attachmentUrl String?
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant        Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assignee      User?               @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([tenantId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([deletedAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String           @db.VarChar(160)
  message   String
  type      NotificationType @default(INFO)
  link      String?
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([deletedAt])
}

model Activity {
  id         String       @id @default(uuid())
  userId     String?
  propertyId String?
  type       ActivityType @default(SYSTEM)
  title      String       @db.VarChar(180)
  message    String
  metadata   Json?
  createdAt  DateTime     @default(now())
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  property   Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([propertyId])
  @@index([type])
  @@index([createdAt])
}
